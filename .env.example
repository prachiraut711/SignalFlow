# SignalFlow Environment Configuration Template
# Copy this file to .env and populate with your environment values.
# NEVER commit the .env file with real secrets to version control.

# Database (Local PostgreSQL / Neon PostgreSQL)
DATABASE_URL=postgresql://signalflow:signalflow_dev@localhost:5432/signalflow_db

# Redis Streams (Local Redis / Upstash rediss://)
REDIS_URL=redis://localhost:6379/0

# OpenRouter AI Incident Explanation (Optional)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Deployment & Server Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
FRONTEND_URL=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Embedded Worker Execution (Set to true on Render free single-service deployment)
EMBED_WORKER=false

# Frontend API URL (Configured in Render Static Site environment)
VITE_API_BASE_URL=

# SignalFlow Environment Configuration
# Copy this file to .env and populate with your local values.
# NEVER commit the .env file with real secrets to version control.

# Database
DATABASE_URL=postgresql://signalflow:signalflow_dev@localhost:5432/signalflow_db

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM / AI Services (Planned for later phases)
GEMINI_API_KEY=

# Server Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

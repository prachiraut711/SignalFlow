# SignalFlow Backend Environment Configuration
# Copy this file to .env and populate with local values.
# NEVER commit the .env file with real secrets to version control.

# Database (PostgreSQL / local SQLite fallback)
DATABASE_URL=postgresql://signalflow:signalflow_dev@localhost:5432/signalflow_db

# Redis Streams
REDIS_URL=redis://localhost:6379/0
REDIS_STREAM_NAME=signalflow:events
REDIS_CONSUMER_GROUP=signalflow-processors
REDIS_CONSUMER_NAME=worker-1

# DuckDB
DUCKDB_PATH=data/signalflow.duckdb

# OpenRouter AI Incident Explanation (Phase 6)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Server Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
FRONTEND_URL=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Embedded Worker Execution (Set to true on Render free single-service deployment)
EMBED_WORKER=false
